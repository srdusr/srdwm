# Rust
/target/
crates/*/target/

# Build directories
build/
build-*/
CMakeCache.txt
CMakeFiles/
cmake-build-*/
Testing/
compile_commands.json

# Binaries and libraries
# Anchored to the repo root: an unanchored `srdwm` matches *any* path
# component with that name, which silently excluded the whole
# `crates/srdwm/` source crate - the binary crate the workspace lists as a
# member, so a fresh clone could not build.
/srdwm
/SRDWM
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# Logs and temporary files
*.log
*.tmp
*.swp
*.DS_Store

# IDE/project files
.vscode/
.idea/
*.user

# Package manager caches
.vcpkg/

# Generated desktop entries if any (installed via CMake, not tracked)
*.desktop
